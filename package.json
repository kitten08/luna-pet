{
  "name": "luna-pet",
  "version": "1.0.0",
  "private": true,
  "description": "Luna 可换装桌面宠物 / Desktop companion",
  "type": "module",
  "main": "desktop/main.cjs",
  "author": "kitten08",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "start": "electron .",
    "pack:mac": "npm run build && electron-builder --mac zip --publish never",
    "pack:win": "npm run build && electron-builder --win portable --publish never",
    "pack:linux": "npm run build && electron-builder --linux AppImage --publish never"
  },
  "devDependencies": {"electron": "45.2.1", "electron-builder": "26.18.0"},
  "build": {
    "appId": "io.kitten08.lunapet",
    "productName": "Luna Pet",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "desktop/**/*", "package.json"],
    "icon": "assets/icon.png",
    "mac": {"category": "public.app-category.entertainment", "identity": null},
    "win": {"target": "portable"},
    "linux": {"target": "AppImage", "category": "Game"}
  }
}
